        <mxCell id="layer-gov" value="8. Platform Governance Layer" style="swimlane;html=1;rounded=1;arcSize=10;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cfd8e3;fontSize=20;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="24" y="1420" width="2152" height="156" as="geometry"/></mxCell>
        <mxCell id="security" value="sub-security-01 | Enterprise security controls&#xa;&lt;font style=&quot;font-size:11px;&quot;&gt;rg-security-platform-01&#xa;Defender for Cloud | Microsoft Sentinel | RBAC | Policy assignments | DDoS Network Protection | Centralized visibility&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f7fb;strokeColor=#979db1;fontSize=15;fontStyle=1;" vertex="1" parent="layer-gov"><mxGeometry x="36" y="44" width="930" height="92" as="geometry"/></mxCell>
        <mxCell id="mg" value="Management group hierarchy&#xa;mg-platform → mg-landingzones → mg-prod / mg-nonprod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f7fb;strokeColor=#979db1;fontSize=15;fontStyle=1;" vertex="1" parent="layer-gov"><mxGeometry x="986" y="44" width="570" height="92" as="geometry"/></mxCell>
        <mxCell id="notes" value="Executive architecture decisions&#xa;1. Traffic Manager is the current DNS-based global routing layer.&#xa;2. Azure Front Door is the strategic future enhancement.&#xa;3. APIM multi-region design depends on Premium classic support.&#xa;4. GPT-4o PTU is in UAE North.&#xa;5. UK Central DR requires warm deployment or degraded mode.&#xa;6. AI Search needs a secondary service or recovery pattern.&#xa;7. Document Intelligence custom models should be copied to DR.&#xa;8. Private endpoints only for AI services.&#xa;9. Managed identity preferred over API keys.&#xa;10. Hub-spoke landing zone centralizes connectivity and security controls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f7fb;strokeColor=#979db1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="layer-gov"><mxGeometry x="1576" y="44" width="546" height="92" as="geometry"/></mxCell>

        <mxCell id="f1" value="User request flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="504" y="406" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="f2" value="RAG flow&#xa;&lt;font style=&quot;font-size:12px;font-weight:400;&quot;&gt;App Service / Orchestrator → AI Search → GPT-4o → APIM → response&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="534" y="603" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="f3" value="Ingestion flow&#xa;&lt;font style=&quot;font-size:12px;font-weight:400;&quot;&gt;Storage / documents → Document Intelligence → chunking / indexing → AI Search&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="264" y="853" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="f4" value="Managed identity → Key Vault" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="702" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="f5" value="Networking flow&#xa;&lt;font style=&quot;font-size:12px;font-weight:400;&quot;&gt;Spoke VNet → Hub VNet → Firewall / DNS resolver → private endpoints&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868" y="1190" width="470" height="36" as="geometry"/></mxCell>
        <mxCell id="f6" value="DR flow&#xa;&lt;font style=&quot;font-size:12px;font-weight:400;&quot;&gt;Traffic Manager failover → UK Central warm DR or degraded mode&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1328" y="326" width="400" height="36" as="geometry"/></mxCell>

