<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="4F56C0F9" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="44"/></w:rPr><w:t>DNS Private Resolver in a Hub-Spoke Hybrid Network</w:t></w:r></w:p><w:p w14:paraId="4E35E7E6" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="24"/></w:rPr><w:t>Pixar-style story + practical flows. Last updated: 2026-01-26</w:t></w:r></w:p><w:p w14:paraId="050E3B6C" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00512F39"/><w:p w14:paraId="0E0A620C" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>You built a hub-spoke city in Azure. On-premises is another city. The big question is always the same: when someone asks for a name, who answers it, and where does the question travel?</w:t></w:r></w:p><w:p w14:paraId="3F602899" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Azure DNS Private Resolver is the managed bridge that lets DNS questions travel both ways:</w:t></w:r><w:r><w:br/><w:t>• On-premises to Azure private names (Private Endpoints)</w:t></w:r><w:r><w:br/><w:t>• Azure workloads to on-premises names</w:t></w:r></w:p><w:p w14:paraId="67023EEF" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>No VM-based DNS forwarder is needed.</w:t></w:r></w:p><w:p w14:paraId="5FFFC7FB" w14:textId="2971EA5A" w:rsidR="0018038D" w:rsidRDefault="0018038D"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="12384F3F" wp14:editId="02662523"><wp:extent cx="5943600" cy="3962400"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1529159835" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1529159835" name="Picture 1529159835"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId6"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3962400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="5C35505B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Architecture overview</w:t></w:r></w:p><w:p w14:paraId="0458A4BB" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Hub-spoke topology with DNS Private Resolver deployed in the hub and Private DNS zones linked to the hub/spokes.</w:t></w:r></w:p><w:p w14:paraId="57B43C1A" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="68244806" wp14:editId="52EBF342"><wp:extent cx="6217920" cy="3497580"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="98a1769d-2dee-4614-ac76-0c96e6ed9767.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId7"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="3497580"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="387284B1" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="18"/></w:rPr><w:t>Figure 1. DNS Private Resolver in the hub (no VM-based DNS forwarder).</w:t></w:r></w:p><w:p w14:paraId="1C594C93" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Cast of characters</w:t></w:r></w:p><w:p w14:paraId="28DB67D0" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>On-premises side</w:t></w:r></w:p><w:p w14:paraId="042A6A30" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Apps and desktops: the callers asking “Where is App1 / blob / api?”</w:t></w:r></w:p><w:p w14:paraId="6A385BD2" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Local DNS servers: 192.168.0.1 and 192.168.0.2 (your home reception desks).</w:t></w:r></w:p><w:p w14:paraId="0F2783D3" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Azure hub</w:t></w:r></w:p><w:p w14:paraId="79F8E4C7" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Inbound endpoint (10.0.0.8): the arrival gate. Receives DNS queries coming into Azure.</w:t></w:r></w:p><w:p w14:paraId="5C6DB029" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Outbound endpoint (10.0.0.19): the departure gate. Sends DNS queries out of Azure (to on-premises DNS).</w:t></w:r></w:p><w:p w14:paraId="770BF71F" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>DNS forwarding rule set: the routing board. Example: if domain is onprem.company.com, forward to 192.168.0.1/2.</w:t></w:r></w:p><w:p w14:paraId="2114657D" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Azure DNS and Private DNS</w:t></w:r></w:p><w:p w14:paraId="26861E64" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Azure-provided DNS (168.63.129.16): Azure’s built-in DNS brain for VNets.</w:t></w:r></w:p><w:p w14:paraId="02489BBA" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Private DNS zones: Azure’s private phonebook for Private Endpoints, for example:</w:t></w:r></w:p><w:p w14:paraId="368AE74B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>privatelink.blob.core.windows.net -&gt; 10.4.0.1</w:t></w:r></w:p><w:p w14:paraId="09D7EEFC" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>privatelink.azure-api.net -&gt; 10.4.0.2</w:t></w:r></w:p><w:p w14:paraId="3BF7EFA5" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>One-line difference vs the old “DNS forwarder VM” pattern</w:t></w:r></w:p><w:p w14:paraId="31B16C54" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Old model: a VM forwarder acted as the bridge. New model: DNS Private Resolver is the bridge. It is managed, highly available, and you do not patch or scale VMs.</w:t></w:r></w:p><w:p w14:paraId="1F7FACA6" w14:textId="6035D6CA" w:rsidR="0018038D" w:rsidRDefault="0018038D"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="0C7DDC54" wp14:editId="29ED9B62"><wp:extent cx="5943600" cy="3962400"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1064127362" name="Picture 2"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1064127362" name="Picture 1064127362"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3962400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="7E958EC1" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Key configuration inputs</w:t></w:r></w:p><w:p w14:paraId="4A9283D0" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Local DNS records and forwarders on-premises</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:jc w:val="center"/><w:tblLook w:val="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="3888"/><w:gridCol w:w="1872"/><w:gridCol w:w="2880"/></w:tblGrid><w:tr w:rsidR="00512F39" w14:paraId="06E22D3B" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3888" w:type="dxa"/></w:tcPr><w:p w14:paraId="71D7AC95" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:rPr><w:b/></w:rPr><w:t>Domain name</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1872" w:type="dxa"/></w:tcPr><w:p w14:paraId="7A04D127" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:rPr><w:b/></w:rPr><w:t>IP address</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2880" w:type="dxa"/></w:tcPr><w:p w14:paraId="25D8BD48" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:rPr><w:b/></w:rPr><w:t>Record type</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="590B0F6D" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3888" w:type="dxa"/></w:tcPr><w:p w14:paraId="2DEDDB25" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>App1.onprem.company.com</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1872" w:type="dxa"/></w:tcPr><w:p w14:paraId="18FCE273" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>192.168.0.8</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2880" w:type="dxa"/></w:tcPr><w:p w14:paraId="38881E9C" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Address mapping (A)</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="7F1EBE83" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3888" w:type="dxa"/></w:tcPr><w:p w14:paraId="185BB0C0" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>App2.onprem.company.com</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1872" w:type="dxa"/></w:tcPr><w:p w14:paraId="10987BA9" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>192.168.0.9</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2880" w:type="dxa"/></w:tcPr><w:p w14:paraId="44CCC7EE" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Address mapping (A)</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="25D3E8B0" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3888" w:type="dxa"/></w:tcPr><w:p w14:paraId="597FAB9D" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>blob.core.windows.net</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1872" w:type="dxa"/></w:tcPr><w:p w14:paraId="11E781FA" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.8</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2880" w:type="dxa"/></w:tcPr><w:p w14:paraId="7972026C" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Conditional forwarder target</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="6C45D9A5" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3888" w:type="dxa"/></w:tcPr><w:p w14:paraId="4D9280BA" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>azure-api.net</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1872" w:type="dxa"/></w:tcPr><w:p w14:paraId="086142C7" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.8</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2880" w:type="dxa"/></w:tcPr><w:p w14:paraId="164B92A7" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Conditional forwarder target</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="4EBB8BFF" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00512F39"/><w:p w14:paraId="0BF695A0" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>DNS Private Resolver parameters in the hub</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:jc w:val="center"/><w:tblLook w:val="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="3600"/><w:gridCol w:w="5040"/></w:tblGrid><w:tr w:rsidR="00512F39" w14:paraId="3A15099C" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa"/></w:tcPr><w:p w14:paraId="0DD6C264" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:rPr><w:b/></w:rPr><w:t>Parameter</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="5040" w:type="dxa"/></w:tcPr><w:p w14:paraId="02EC30B4" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:rPr><w:b/></w:rPr><w:t>Value</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="5DF4301F" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa"/></w:tcPr><w:p w14:paraId="541E838F" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Virtual network (hub)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="5040" w:type="dxa"/></w:tcPr><w:p w14:paraId="31A9E648" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.0/24</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="49BA9883" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa"/></w:tcPr><w:p w14:paraId="7BE6F88A" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Inbound endpoint subnet</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="5040" w:type="dxa"/></w:tcPr><w:p w14:paraId="66D9B9D2" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.0/28</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="69BF5649" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa"/></w:tcPr><w:p w14:paraId="1679B0A9" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Inbound endpoint IP</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="5040" w:type="dxa"/></w:tcPr><w:p w14:paraId="557AF96B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.8</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="77C82E73" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa"/></w:tcPr><w:p w14:paraId="6C5E153E" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Outbound endpoint subnet</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="5040" w:type="dxa"/></w:tcPr><w:p w14:paraId="7061ECD9" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.16/28</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00512F39" w14:paraId="62AC2040" w14:textId="77777777"><w:trPr><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3600" w:type="dxa"/></w:tcPr><w:p w14:paraId="55AAE817" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Outbound endpoint IP</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="5040" w:type="dxa"/></w:tcPr><w:p w14:paraId="18968D01" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>10.0.0.19</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="005E1CA2" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>The 3 DNS flows (separate stories)</w:t></w:r></w:p><w:p w14:paraId="357D1D1D" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Flow 1. On-premises asks for an Azure Private Endpoint name</w:t></w:r></w:p><w:p w14:paraId="1BD2A619" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Example: an on-premises app asks for blob.core.windows.net (which should resolve to a private endpoint IP).</w:t></w:r></w:p><w:p w14:paraId="7B3AD6A9" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="40E00617" wp14:editId="6D567566"><wp:extent cx="6217920" cy="3534013"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="2" name="Picture 2"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="de1383a0-0376-4720-b3ba-d97c1447334f.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="3534013"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="1B49F979" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="18"/></w:rPr><w:t>Figure 2. Flow 1: On-premises -&gt; Azure private name (via inbound endpoint).</w:t></w:r></w:p><w:p w14:paraId="7FF455F8" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>1. An on-premises client asks local DNS (192.168.0.1/2) to resolve blob.core.windows.net.</w:t></w:r></w:p><w:p w14:paraId="5B930214" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>2. Local DNS uses a conditional forwarder for blob.core.windows.net and forwards the query to the hub inbound endpoint 10.0.0.8.</w:t></w:r></w:p><w:p w14:paraId="31C3A431" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>3. DNS Private Resolver receives the query and consults Azure DNS (which can see VNet links).</w:t></w:r></w:p><w:p w14:paraId="397EA6FF" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>4. Azure Private DNS zone resolves the privatelink record and returns the private IP (for example 10.4.0.1).</w:t></w:r></w:p><w:p w14:paraId="4AD94B25" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>5. The answer returns back through the same path to the on-premises client.</w:t></w:r></w:p><w:p w14:paraId="0D24A15D" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t xml:space="preserve">Result: </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>on-premises</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> resolves Azure private endpoints without running any DNS forwarder VM in Azure.</w:t></w:r></w:p><w:p w14:paraId="5927C138" w14:textId="77777777" w:rsidR="00AA1B47" w:rsidRDefault="00AA1B47"/><w:p w14:paraId="7225E692" w14:textId="56F143B4" w:rsidR="00AA1B47" w:rsidRDefault="00AA1B47"><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="00BF2FB4" wp14:editId="364B1105"><wp:extent cx="5943600" cy="3962400"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1542624826" name="Picture 3"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1542624826" name="Picture 1542624826"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId10"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3962400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="514F14DF" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Flow 2. Azure VM asks for an Azure private name (default Azure DNS)</w:t></w:r></w:p><w:p w14:paraId="61E08FAB" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Example: a VM in Spoke 1 asks for abc.privatelink.blob.core.windows.net or blob.core.windows.net.</w:t></w:r></w:p><w:p w14:paraId="7EF47918" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="28E2AA1D" wp14:editId="1AA4EF48"><wp:extent cx="6217920" cy="3543121"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="3" name="Picture 3"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="a6f234bb-7cd0-4e9c-8459-4911d2d90bf2.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId11"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="3543121"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="03D69618" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="18"/></w:rPr><w:lastRenderedPageBreak/><w:t>Figure 3. Flow 2: Spoke VM -&gt; Azure private name (Azure DNS + Private DNS zone).</w:t></w:r></w:p><w:p w14:paraId="5A48BA4F" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>1. VM1 uses Azure-provided DNS (168.63.129.16) to resolve the name.</w:t></w:r></w:p><w:p w14:paraId="33204D41" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>2. Azure DNS detects that a linked Private DNS zone owns the name (for example privatelink.blob.core.windows.net).</w:t></w:r></w:p><w:p w14:paraId="7940874F" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>3. Azure Private DNS zone returns the private endpoint IP (for example 10.4.0.1).</w:t></w:r></w:p><w:p w14:paraId="3B93D397" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>4. VM1 connects to the service privately using that IP (data plane is separate from DNS).</w:t></w:r></w:p><w:p w14:paraId="3129254B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t xml:space="preserve">Result: Azure workloads resolve private endpoint names natively </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>as long as</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> the right Private DNS zones are linked to the hub/spokes.</w:t></w:r></w:p><w:p w14:paraId="2DB1BF12" w14:textId="77777777" w:rsidR="00AA1B47" w:rsidRDefault="00AA1B47"/><w:p w14:paraId="55BFE016" w14:textId="756621D2" w:rsidR="00AA1B47" w:rsidRDefault="00AA1B47"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="6A2C58B7" wp14:editId="5F7E1316"><wp:extent cx="5943600" cy="3962400"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="515554103" name="Picture 4"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="515554103" name="Picture 515554103"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId12"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3962400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="12887522" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Flow 3. Azure VM asks for an on-premises name (the outbound path)</w:t></w:r></w:p><w:p w14:paraId="18024663" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Example: VM1 asks for app1.onprem.company.com. Azure DNS does not know this record unless you add forwarding.</w:t></w:r></w:p><w:p w14:paraId="2A52FDD0" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="447C6157" wp14:editId="72AF2BAE"><wp:extent cx="6217920" cy="3500616"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="4" name="Picture 4"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="7746e94c-5d09-415e-80cb-f9a3008f7426.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId13"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="3500616"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="4CDFD0BB" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="18"/></w:rPr><w:t>Figure 4. Flow 3: Spoke VM -&gt; on-premises name (via outbound endpoint and forwarding rules).</w:t></w:r></w:p><w:p w14:paraId="41576A4E" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>1. VM1 asks Azure DNS (168.63.129.16) to resolve app1.onprem.company.com.</w:t></w:r></w:p><w:p w14:paraId="5195FA0B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>2. Azure DNS sees no matching Private DNS zone for that name. It checks whether the VNet is linked to a DNS forwarding rule set.</w:t></w:r></w:p><w:p w14:paraId="01A64B52" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>3. A forwarding rule matches onprem.company.com and sends the query to DNS Private Resolver.</w:t></w:r></w:p><w:p w14:paraId="63A43BAA" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>4. DNS Private Resolver forwards the query out via the outbound endpoint (10.0.0.19) to on-premises DNS (192.168.0.1/2).</w:t></w:r></w:p><w:p w14:paraId="2E91CF6A" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:ind w:left="360" w:hanging="216"/></w:pPr><w:r><w:t>5. On-premises DNS returns the A record (for example 192.168.0.8). The answer returns back to VM1.</w:t></w:r></w:p><w:p w14:paraId="2ACECE9B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Result: Azure workloads can resolve on-premises names without pointing every VM directly to on-premises DNS servers.</w:t></w:r></w:p><w:p w14:paraId="02CC4499" w14:textId="7C3FC059" w:rsidR="00AA1B47" w:rsidRDefault="00AA1B47"><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="34C2FFC2" wp14:editId="4A29E086"><wp:extent cx="5943600" cy="3962400"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1853945489" name="Picture 5"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1853945489" name="Picture 1853945489"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId14"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3962400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="5AD8D385" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Why the diagrams show different VM DNS settings</w:t></w:r></w:p><w:p w14:paraId="4B376C88" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Option A (recommended for most): use default Azure DNS</w:t></w:r></w:p><w:p w14:paraId="284B87BB" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Spoke VMs use Azure-provided DNS (168.63.129.16). Private DNS zones handle Azure private names. Forwarding rule sets handle on-premises names via DNS Private Resolver.</w:t></w:r></w:p><w:p w14:paraId="74A2E11B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Option B: point spoke VNets to the inbound endpoint (10.0.0.8)</w:t></w:r></w:p><w:p w14:paraId="27A2B049" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Spoke VMs send every query to DNS Private Resolver first. This gives one DNS IP for everything, but increases dependency on the hub path.</w:t></w:r></w:p><w:p w14:paraId="2751B484" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="452BB3B0" wp14:editId="38993BFB"><wp:extent cx="6217920" cy="3509724"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="5" name="Picture 5"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="aa53e275-cd88-4f5b-9a69-6d9a8d104db7.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId15"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="3509724"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="0486F72F" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="18"/></w:rPr><w:t>Figure 5. Option B: Spoke workloads use 10.0.0.8 as their DNS server (inbound endpoint).</w:t></w:r></w:p><w:p w14:paraId="48C587A3" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Option C: point spoke VNets to on-premises DNS (192.168.0.1/2)</w:t></w:r></w:p><w:p w14:paraId="5CF14F94" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:r><w:t>Classic approach. Works, but Azure workloads now depend on on-premises DNS latency and availability for most lookups.</w:t></w:r></w:p><w:p w14:paraId="3086D907" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="699EEC3D" wp14:editId="10D9DB1F"><wp:extent cx="6217920" cy="3452039"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="6" name="Picture 6"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="a7fc94bc-b483-4127-babf-b9131eb9d2c5.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId16"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="3452039"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="4040A979" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:sz w:val="18"/></w:rPr><w:lastRenderedPageBreak/><w:t>Figure 6. Option C: Spoke workloads use on-premises DNS servers directly.</w:t></w:r></w:p><w:p w14:paraId="0BB26F30" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Minimal checklist to make this work</w:t></w:r></w:p><w:p w14:paraId="57602AF3" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>On-premises DNS (192.168.0.1/2)</w:t></w:r></w:p><w:p w14:paraId="1F5C940E" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Create local A records, for example app1.onprem.company.com -&gt; 192.168.0.8.</w:t></w:r></w:p><w:p w14:paraId="3DA8A684" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Create conditional forwarders for Azure services that you want to resolve privately, for example:</w:t></w:r></w:p><w:p w14:paraId="0A08F018" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>blob.core.windows.net -&gt; 10.0.0.8</w:t></w:r></w:p><w:p w14:paraId="13EF8FE7" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>azure-api.net -&gt; 10.0.0.8</w:t></w:r></w:p><w:p w14:paraId="687059D2" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Azure hub</w:t></w:r></w:p><w:p w14:paraId="3932C360" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Deploy DNS Private Resolver with dedicated subnets for inbound and outbound endpoints (/28 or larger).</w:t></w:r></w:p><w:p w14:paraId="6B7E1DE7" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Link the hub VNet to required Private DNS zones, for example privatelink.blob.core.windows.net and privatelink.azure-api.net.</w:t></w:r></w:p><w:p w14:paraId="604E1390" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Create a DNS forwarding rule set for onprem.company.com -&gt; 192.168.0.1, 192.168.0.2.</w:t></w:r></w:p><w:p w14:paraId="2E5163D7" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Link the rule set to spoke VNets that must resolve on-premises names.</w:t></w:r></w:p><w:p w14:paraId="036FF17F" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Ensure routes and firewall rules allow DNS (UDP/TCP 53) between on-premises &lt;-&gt; inbound endpoint and outbound endpoint &lt;-&gt; on-premises DNS.</w:t></w:r></w:p><w:p w14:paraId="78904610" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Mental model you can remember in 10 seconds</w:t></w:r></w:p><w:p w14:paraId="51DCC51A" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Private DNS zone = Azure’s private phonebook.</w:t></w:r></w:p><w:p w14:paraId="1D8268DD" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Inbound endpoint = on-premises asking Azure.</w:t></w:r></w:p><w:p w14:paraId="2EFDA7C6" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Outbound endpoint = Azure asking on-premises.</w:t></w:r></w:p><w:p w14:paraId="541A2754" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Rule set = which domains must be forwarded out to on-premises.</w:t></w:r></w:p><w:p w14:paraId="0A639789" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>Common mistakes that break this design</w:t></w:r></w:p><w:p w14:paraId="29B92A54" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Private DNS zone is created but not linked to the right VNet(s).</w:t></w:r></w:p><w:p w14:paraId="3F999DE6" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>DNS forwarding rule set is created but not linked to the correct spoke VNet.</w:t></w:r></w:p><w:p w14:paraId="034B620A" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>NSG/Azure Firewall blocks UDP/TCP 53 on the path (on-premises &lt;-&gt; inbound endpoint, outbound endpoint &lt;-&gt; on-premises DNS).</w:t></w:r></w:p><w:p w14:paraId="7DFCD92B" w14:textId="77777777" w:rsidR="00512F39" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Pointing name resolution of an ExpressRoute gateway VNet to a wildcard custom DNS server can break management connectivity. Avoid wildcard patterns in gateway VNets.</w:t></w:r></w:p><w:sectPr w:rsidR="00512F39" w:rsidSect="00034616"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>