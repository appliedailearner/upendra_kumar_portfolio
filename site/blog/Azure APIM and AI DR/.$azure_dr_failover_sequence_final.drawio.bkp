<mxCell id="s3" value="&lt;div style=&quot;text-align:left;padding:10px;&quot;&gt;4. Use DR APIM\nSweden Central APIM takes traffic using aligned APIOps/IaC policies.&lt;/div&gt;" style="rounded=1;fillColor=#F3F2F1;fontColor=#000000;strokeColor=#C8C6C4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="100" as="geometry"/></mxCell>
