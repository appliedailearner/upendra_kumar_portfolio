<mxCell id="s2" value="&lt;div style=&quot;text-align:left;padding:10px;&quot;&gt;3. Promote DR Ingress\nTraffic routed to Sweden Central App Gateway organically. No client change.&lt;/div&gt;" style="rounded=1;fillColor=#F3F2F1;fontColor=#000000;strokeColor=#C8C6C4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="260" height="100" as="geometry"/></mxCell>
