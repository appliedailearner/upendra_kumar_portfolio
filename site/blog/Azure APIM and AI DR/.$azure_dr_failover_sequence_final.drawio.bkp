<mxCell id="s0" value="&lt;div style=&quot;text-align:left;padding:10px;&quot;&gt;1. Detect Failure\nFront Door health probes fail on UAE North. Regional ingress is marked unhealthy.&lt;/div&gt;" style="rounded=1;fillColor=#F3F2F1;fontColor=#000000;strokeColor=#C8C6C4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;div style=&quot;text-align:left;padding:10px;&quot;&gt;2. Stop Primary Routing\nFront Door stops sending requests to UAE North. Public DNS stays same.&lt;/div&gt;" style="rounded=1;fillColor=#F3F2F1;fontColor=#000000;strokeColor=#C8C6C4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="260" height="100" as="geometry"/></mxCell>
